{
  "name": "VoiceConfig ASR device profiles",
  "description": "Device profiles used for benchmark regression gates. Thresholds are initial values; update after real-device baselines are collected.",
  "profiles": {
    "arm64-flagship": {
      "label": "arm64 旗舰（高通 8 系 / 大内存）",
      "abi": "arm64-v8a",
      "soc_examples": ["SM8550", "SM8650", "SM8750"],
      "default_threads": 4,
      "default_provider": "cpu",
      "gates": {
        "max_cer": 0.15,
        "max_rtf": 0.8,
        "max_avg_total_ms": 4000,
        "min_keyword_pass": 6
      }
    },
    "arm64-midrange": {
      "label": "arm64 中端（高通 6/7 系 / 中等内存）",
      "abi": "arm64-v8a",
      "soc_examples": ["SM6375", "SM7325", "SM7450"],
      "default_threads": 2,
      "default_provider": "cpu",
      "gates": {
        "max_cer": 0.18,
        "max_rtf": 1.2,
        "max_avg_total_ms": 6000,
        "min_keyword_pass": 5
      }
    },
    "emulator-x86_64": {
      "label": "x86_64 模拟器（仅回归，不代表真机）",
      "abi": "x86_64",
      "soc_examples": ["emulator"],
      "default_threads": 4,
      "default_provider": "cpu",
      "gates": {
        "max_cer": 0.20,
        "max_rtf": 2.5,
        "max_avg_total_ms": 12000,
        "min_keyword_pass": 4
      }
    }
  }
}
